{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/apps/rpicam-surv",
            "args": [
                "-t", "0",
                "-r", "--inline", "--enable-email-alerts",
                "--web-host", "0.0.0.0",
                "--web-port", "8000",
                "--profile", "baseline",
                "--post-process-file", "assets/surveillance.json",
                "--alert-config-file", "assets/alert_config.json",
                "--autofocus-mode", "manual",
                "--width", "640",
                "--height", "480"
            ],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "compile&install",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "pretty printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "disassembly-flavor Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}